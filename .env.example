# Backend API Configuration
# In Local Development: http://127.0.0.1:8000
# On Vercel (Production): https://wellness-diagnostic-backend.onrender.com
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Supabase Credentials (from your Supabase project dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-do-not-expose-to-client

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Map & Geocoding
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=
